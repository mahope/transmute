{
  "$schema": "https://raw.githubusercontent.com/nousresearch/hermes-software-ecosystem/main/tauri/schema.json",
  "productName": "Transmute",
  "version": "0.1.0",
  "identifier": "com.mahope.transmute",
  "build": {
    "frontendDist": "../frontend",
    "devUrl": "http://localhost:1421",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Transmute — Data Transformer",
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
